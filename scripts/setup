#!/usr/bin/env bash
# Run inside the Ubuntu guest as the regular Lima user.
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$(id -u)" == 0 ]]; then
    echo 'Run as the regular guest user; Ansible uses sudo for system packages.' >&2
    exit 1
fi
if ! command -v ansible-playbook >/dev/null 2>&1; then
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y ansible-core
fi
exec ansible-playbook -i "$repo_dir/ansible/inventory.ini" "$repo_dir/ansible/site.yml" "$@"
