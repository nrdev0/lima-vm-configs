#!/usr/bin/env bash
# Run inside the Ubuntu guest as the regular Lima user.
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$(id -u)" == 0 ]]; then
    echo 'Run as the regular guest user; Ansible uses sudo for system packages.' >&2
    exit 1
fi
retry_apt() {
    local attempt status
    for attempt in 1 2 3; do
        if sudo env DEBIAN_FRONTEND=noninteractive apt-get \
            -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 "$@"; then
            return 0
        else
            status=$?
        fi
        if [[ "$attempt" == 3 ]]; then
            echo 'APT bootstrap failed after three attempts.' >&2
            return "$status"
        fi
        echo 'APT is busy or unavailable; retrying in 10 seconds...' >&2
        sleep 10
    done
}
if ! command -v ansible-playbook >/dev/null 2>&1; then
    retry_apt update -o APT::Update::Error-Mode=any
    retry_apt install -y ansible-core
fi
exec ansible-playbook -i "$repo_dir/ansible/inventory.ini" "$repo_dir/ansible/site.yml" "$@"
