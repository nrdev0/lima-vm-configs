#!/usr/bin/env bash
# Run on the host. Back up guest projects, including .git and untracked files.
set -euo pipefail
if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $0 VM_NAME [BACKUP_ROOT]" >&2
    exit 2
fi
vm_name="$1"
backup_root="${2:-$HOME/Backups/lima}"
for command_name in limactl tar; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "Required host command is missing: $command_name" >&2
        exit 1
    fi
done
if command -v shasum >/dev/null 2>&1; then
    checksum_command=(shasum -a 256)
elif command -v sha256sum >/dev/null 2>&1; then
    checksum_command=(sha256sum)
else
    echo 'Install shasum or sha256sum on the host to verify backups.' >&2
    exit 1
fi

umask 077
mkdir -p -- "$backup_root"
backup_root=$(cd -- "$backup_root" && pwd)
backup_dir=$(mktemp -d "$backup_root/projects-$(date -u +%Y%m%dT%H%M%SZ).XXXXXXXX")
complete=no
cleanup() {
    if [[ "$complete" != yes ]]; then
        rm -rf -- "$backup_dir"
    fi
}
trap cleanup EXIT
echo "Backing up $vm_name:~/src..."
limactl shell "$vm_name" bash -c '
    set -euo pipefail
    cd -- "$HOME/src"
    exec tar --exclude=.venv --exclude=__pycache__ \
        --exclude=.pytest_cache --exclude=.ruff_cache --exclude=.mypy_cache \
        --exclude=.tox --exclude=.nox -czf - .
' > "$backup_dir/projects.tar.gz"

# Validate the stream before declaring the snapshot complete.
tar -tzf "$backup_dir/projects.tar.gz" >/dev/null
(
    cd -- "$backup_dir"
    "${checksum_command[@]}" projects.tar.gz > SHA256SUMS
)
printf '%s\n' "$vm_name" > "$backup_dir/VM_NAME"
complete=yes
printf 'Backup complete: %s\n' "$backup_dir"
echo 'The snapshot includes untracked files and may contain project secrets.'
