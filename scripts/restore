#!/usr/bin/env bash
# Run on the host. Restore a project backup into a new guest directory.
set -euo pipefail
if [[ $# != 2 ]]; then
    echo "Usage: $0 VM_NAME BACKUP_DIRECTORY" >&2
    exit 2
fi
vm_name="$1"
backup_dir=$(cd -- "$2" && pwd)
if ! command -v limactl >/dev/null 2>&1; then
    echo 'Required host command is missing: limactl' >&2
    exit 1
fi
if command -v shasum >/dev/null 2>&1; then
    checksum_command=(shasum -a 256)
elif command -v sha256sum >/dev/null 2>&1; then
    checksum_command=(sha256sum)
else
    echo 'Install shasum or sha256sum on the host to verify backups.' >&2
    exit 1
fi
(
    cd -- "$backup_dir"
    "${checksum_command[@]}" -c SHA256SUMS
)

limactl shell "$vm_name" bash -c '
    set -euo pipefail
    umask 077
    restore_dir=$(mktemp -d "$HOME/src-restored.XXXXXXXX")
    complete=no
    cleanup() {
        if [[ "$complete" != yes ]]; then rm -rf -- "$restore_dir"; fi
    }
    trap cleanup EXIT
    tar --no-same-owner --no-same-permissions -xzf - -C "$restore_dir"
    complete=yes
    printf "Restored projects to: %s\n" "$restore_dir"
    echo "Inspect this directory before moving any projects into ~/src."
' < "$backup_dir/projects.tar.gz"
